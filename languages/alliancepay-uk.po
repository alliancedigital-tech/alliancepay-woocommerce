msgid "Payment via Hosted Payment Page of Alliance Bank."
msgstr "Оплата через Hosted Payment Page Альянс Банку."

msgid "Payment successful"
msgstr "Платіж успішний"

msgid "Thank you for your payment!"
msgstr "Дякуємо за оплату!"

msgid "Your payment status: <strong>successful</strong>."
msgstr "Статус вашого платежу: <strong>успішно</strong>."

msgid "Return to homepage"
msgstr "Повернутися на головну"

msgid "Payment failed"
msgstr "Платіж не виконано"

msgid "Unfortunately, the payment failed"
msgstr "На жаль, платіж не виконано"

msgid "Please try again or contact us."
msgstr "Будь ласка, спробуйте ще раз або зв’яжіться з нами."

msgid "Documentation"
msgstr "Документація"

msgid "Settings"
msgstr "Налаштування"

msgid "AlliancePay payment status"
msgstr "Статус платежу AlliancePay"

msgid "Payment status"
msgstr "Статус платежу"

msgid "No callback from AlliancePay. Check \"Payment status\""
msgstr "Немає колбеку від AlliancePay. Перевірте \"Статус платежу\""

msgid "AlliancePay status"
msgstr "AlliancePay статус"

msgid "AlliancePay Plugin — Documentation"
msgstr "AlliancePay Plugin — Документація"

msgid "Main settings"
msgstr "Основні налаштування"

msgid "Base URL API (provided by the bank) *"
msgstr "Base URL API (надає банк) *"

msgid "Merchant ID (provided by the bank) *"
msgstr "Merchant ID (надає банк) *"

msgid "Service Code (provided by the bank) *"
msgstr "Service Code (надає банк) *"

msgid "Private JWK *"
msgstr "Private JWK *"

msgid "Device ID"
msgstr "Device ID"

msgid "Refresh Token"
msgstr "Refresh Token"

msgid "Success URL"
msgstr "Success URL"

msgid "Fail URL"
msgstr "Fail URL"

msgid "Private key for decrypting JWE. Not public."
msgstr "Приватний ключ для розшифрування JWE. Не публічний."

msgid "Information field. Updates after authorization."
msgstr "Інформаційне поле. Оновлюється після авторизації."

msgid "Page to return the user after payment"
msgstr "Сторінка повернення користувачу після оплати"

msgid "AlliancePay — Settings"
msgstr "AlliancePay — Налаштування"

msgid "Token valid until:"
msgstr "Токен дійсний до:"

msgid "Auto-update every 12 hours, "
msgstr "Автооновлення кожні 12 годин, "

msgid "left ~%d hrs."
msgstr "залишилось ~%d год."

msgid "Reauthorize now"
msgstr "Переавторизувати зараз"

msgid "Reauthorizing..."
msgstr "Переавторизація..."

msgid "Done"
msgstr "Готово"

msgid "Error"
msgstr "Помилка"

msgid "Network error"
msgstr "Помилка мережі"

msgid "How to use:"
msgstr "Як користуватись:"

msgid "The checkout page must contain the shortcode <code>[woocommerce_checkout]</code>. "
msgstr "На сторінці оплати повинен бути шорткод <code>[woocommerce_checkout]</code>. "

msgid "Make sure <code>Merchant ID</code>, <code>Service Code</code>, and <code>Private JWK</code> are filled in.<br> "
msgstr "Переконайтесь, що <code>Merchant ID</code>, <code>Service Code</code> та <code>Private JWK</code> заповнені.<br> "

msgid "On the first connection, click \"Reauthorize now\", verify that the <code>Device ID</code> and <code>Refresh Token</code> fields are filled automatically.<br>"
msgstr "При першому підключенні натисність \"Переавторизувати зараз\", перевірте що поля <code>Device ID</code> та <code>Refresh Token</code> автоматично заповнились.<br>"

msgid "Set up the <code>Success URL</code> and <code>Fail URL</code> pages for redirection after successful (or unsuccessful) payment from the bank website.<br>"
msgstr "Налаштуйте сторінки <code>Success URL</code> та <code>Fail URL</code> для перенаправлення після успішної (або ні) оплати з сайту банку.<br>"

msgid "Synchronization error"
msgstr "Помилка синхронізації"

msgid "Updating..."
msgstr "Оновлення..."

msgid "Payment via Hosted Payment Page of Alliance Bank"
msgstr "Оплата через Hosted Payment Page Альянс Банку"

msgid "Pay with AlliancePay using Visa, Mastercard, ApplePay, GooglePay"
msgstr "Оплатити за допомогою AlliancePay картками Visa, Mastercard, ApplePay, GooglePay"

msgid "Enable/Disable"
msgstr "Увімкнути/Вимкнути"

msgid "Enable this payment method"
msgstr "Увімкнути цей платіжний метод"

msgid "Payment via Alliance Bank."
msgstr "Оплата через Банк Альянс."

msgid "A technical error occurred"
msgstr "Сталась технічна помилка"

msgid "Payment received via AlliancePay"
msgstr "Оплата отримана через AlliancePay"

msgid "Payment failed via AlliancePay"
msgstr "Оплата не пройшла через AlliancePay"

msgid "This order was not paid via AlliancePay"
msgstr "Це замовлення оплачено не через AlliancePay"

msgid "An error occurred while contacting AlliancePay"
msgstr "Виникла помилка при зверненні до AlliancePay"

msgid "AlliancePay Order Status"
msgstr "Статус замовлення AlliancePay"

msgid "AlliancePay payment details"
msgstr "Деталі по оплаті через AlliancePay"

msgid "⬅ Back to order list"
msgstr "⬅ Назад до списку замовлень"

msgid "Order ID:"
msgstr "ID Замовлення:"

msgid "Woocommerce Order Status:"
msgstr "Статус замовлення Woocommerce:"

msgid "Order Total:"
msgstr "Сума замовлення:"

msgid "Callback from AllianceBank not received. The data below is taken directly from AlliancePay"
msgstr "Колбек від AllianceBank не отримано. Дані нижче напряму взяті з AlliancePay"

msgid "Callback from AllianceBank received. The data below is received from the callback and loaded into the DB"
msgstr "Колбек від AllianceBank отримано. Дані нижче отримано з колбеку і завантажено в БД"

msgid "JWE not received in the authorize_virtual_device response"
msgstr "Не отримано jwe у відповіді authorize_virtual_device"

msgid "SimpleJWT library not found (lib/simplejwt/init.php)."
msgstr "SimpleJWT бібліотека не знайдена (lib/simplejwt/init.php)."

msgid "Invalid Private JWK: missing d/x/y."
msgstr "Некоректний Private JWK: відсутні d/x/y."

msgid "Settings are incomplete for reauthorization."
msgstr "Налаштування неповні для повторної авторизації."

msgid "Private JWK must be valid JSON"
msgstr "Private JWK має бути валідним JSON"

msgid "Token expired (200 days of inactivity). Contact bank support, then retry authorization."
msgstr "Токен протерміновано (200 днів без активності). Зверніться до підтримки банку, потім повторіть авторизацію."

msgid "MerchantId is not set in the plugin settings."
msgstr "Не задано merchantId у налаштуваннях плагіна."

msgid "DeviceId/refreshToken are not set in the plugin settings."
msgstr "Не задано deviceId/refreshToken у налаштуваннях плагіна."

msgid "Maximum number of attempts (%1$d) exceeded for request %2$s %3$s"
msgstr "Перевищено максимальну кількість спроб (%1$d) для запиту %2$s %3$s"

msgid "401 Unauthorized from API after %d attempts. Check deviceId/refreshToken."
msgstr "401 Unauthorized від API після %d спроб. Перевір deviceId/refreshToken."

msgid "Purchase operation not found"
msgstr "Не знайдено операції купівлі"

msgid "This purchase transaction is not allowed to refund online through Bank Alliance"
msgstr "Цю покупку не можна повернути онлайн через Bank Alliance"

msgid "HPP Payment Type *"
msgstr "Тип HPP-платежу *"

msgid "PREAUTH: Pre-Auth Expiration"
msgstr "PREAUTH: Термін дії попередньої авторизації"

msgid "PREAUTH: On-Hold Status (after preauth creation)"
msgstr "PREAUTH: Статус очікування (після створення preauth)"

msgid "PREAUTH: Completion Trigger Status (admin confirms capture)"
msgstr "PREAUTH: Статус підтвердження списання (адмін підтверджує захоплення коштів)"

msgid "2 hours"
msgstr "2 години"

msgid "4 hours"
msgstr "4 години"

msgid "6 hours"
msgstr "6 годин"

msgid "12 hours"
msgstr "12 годин"

msgid "1 day"
msgstr "1 день"

msgid "2 days"
msgstr "2 дні"

msgid "7 days"
msgstr "7 днів"

msgid "14 days"
msgstr "14 днів"

msgid "28 days"
msgstr "28 днів"

msgid "Pre-auth authorization validity period. Min: 2 hours, Max: 28 days. Only applies when HPP Payment Type is PREAUTH."
msgstr "Термін дії preauth-авторизації. Мін: 2 години, Макс: 28 днів. Застосовується лише якщо обрано тип платежу PREAUTH."

msgid "Order status set after PREAUTH creation (bank authorized but not captured). Default: On hold."
msgstr "Статус замовлення після створення PREAUTH (банк авторизував, але кошти не списані). За замовчуванням: Очікує оплати."

msgid "When admin sets the order to this status, a capture request is sent to the bank. Default: Processing."
msgstr "Коли адмін переводить замовлення в цей статус, банку надсилається запит на списання коштів. За замовчуванням: В обробці."

msgid "PREAUTH authorization created via AlliancePay. Awaiting admin confirmation to capture funds."
msgstr "PREAUTH-авторизацію створено через AlliancePay. Очікується підтвердження адміністратора для списання коштів."

msgid "PREAUTH authorization failed via AlliancePay."
msgstr "PREAUTH-авторизацію не виконано через AlliancePay."

msgid "AlliancePay PREAUTH callback received. operation_id stored. Awaiting admin capture confirmation."
msgstr "Отримано callback AlliancePay PREAUTH. operation_id збережено. Очікується підтвердження адміністратора для списання."

msgid "AlliancePay PREAUTH capture blocked: operation_id is empty. The preauth callback from the bank has not been received yet. Please wait for the callback and try again."
msgstr "Списання PREAUTH заблоковано: operation_id відсутній. Callback від банку ще не отримано. Зачекайте на callback і спробуйте знову."

msgid "AlliancePay PREAUTH capture blocked: order total %1$s UAH (coins: %2$d) is outside the allowed ±20%% range of the original authorized amount %3$s UAH (allowed: %4$d–%5$d coins)."
msgstr "Списання PREAUTH заблоковано: сума замовлення %1$s грн (копійок: %2$d) виходить за межі допустимого діапазону ±20%% від початково авторизованої суми %3$s грн (дозволено: %4$d–%5$d копійок)."

msgid "AlliancePay PREAUTH capture request sent successfully. Amount: %s coins. Awaiting bank callback to finalize."
msgstr "Запит на списання PREAUTH успішно надіслано. Сума: %s копійок. Очікується callback від банку для завершення."

msgid "AlliancePay PREAUTH capture failed: %s"
msgstr "Помилка списання PREAUTH через AlliancePay: %s"

msgid "Funds will be reserved and captured after order confirmation by the administrator."
msgstr "Кошти будуть зарезервовані та списані після підтвердження замовлення адміністратором."

msgid "Invalid request."
msgstr "Некоректний запит."

msgid "AlliancePay: fiscalization"
msgstr "AlliancePay: фіскалізація"

msgid "Fiscalization is not available for this order."
msgstr "Фіскалізація недоступна для цього замовлення."

msgid "No successful AlliancePay payment or refund to fiscalize yet."
msgstr "Ще немає успішного платежу чи повернення AlliancePay для фіскалізації."

msgid "Type"
msgstr "Тип"

msgid "Status"
msgstr "Статус"

msgid "Fiscal number"
msgstr "Фіскальний номер"

msgid "Receipt"
msgstr "Чек"

msgid "Date"
msgstr "Дата"

msgid "View receipt"
msgstr "Переглянути чек"

msgid "Fiscalize"
msgstr "Фіскалізувати"

msgid "Refresh status"
msgstr "Оновити статус"

msgid "Tax group code"
msgstr "Код податкової групи"

msgid "Integer. Empty — default from AlliancePay settings."
msgstr "Ціле число. Порожньо — дефолт із налаштувань AlliancePay."

msgid "UKTZED code"
msgstr "УКТЗЕД"

msgid "Digits only. Required for tax codes 2, 7, 8 (here or in settings)."
msgstr "Лише цифри. Обов'язково для кодів податку 2, 7, 8 (тут або в налаштуваннях)."

msgid "Excise stamps"
msgstr "Акцизні марки"

msgid "Comma-separated. For excise goods with tax codes 2, 7, 8."
msgstr "Через кому. Для підакцизних товарів з кодами податку 2, 7, 8."

msgid "Unit of measure code"
msgstr "Код одиниці виміру"

msgid "Empty — default from settings (\"0001\")."
msgstr "Порожньо — дефолт із налаштувань (\"0001\")."

msgid "Empty value — taken from the parent product."
msgstr "Порожнє значення береться з батьківського товару."

msgid "Product \"%1$s\": classification code (UKTZED) is required for tax codes %2$s."
msgstr "Товар \"%1$s\": для кодів податку %2$s обов'язковий код УКТЗЕД."

msgid "Tax code must be an integer."
msgstr "Код податкової групи має бути цілим числом."

msgid "UKTZED code must contain digits only."
msgstr "УКТЗЕД має містити лише цифри."

msgid "UKTZED code is required when the tax code is one of: %s."
msgstr "УКТЗЕД обов'язковий, якщо код податку один із: %s."

msgid "Fiscalization is disabled in settings."
msgstr "Фіскалізацію вимкнено в налаштуваннях."

msgid "This order cannot be fiscalized (not an AlliancePay one-time payment)."
msgstr "Це замовлення не можна фіскалізувати (не разовий платіж AlliancePay)."

msgid "Fiscalization already exists for this operation."
msgstr "Для цієї операції фіскалізація вже існує."

msgid "Fiscalization of this operation has failed in Alliance Kasa; a repeated request returns the same result. Use \"Refresh status\"."
msgstr "Фіскалізація цієї операції завершилась помилкою в Alliance Kasa; повторний запит поверне той самий результат. Скористайтесь «Оновити статус»."

msgid "Fiscalization record not found."
msgstr "Запис фіскалізації не знайдено."

msgid "Stored request is empty; use \"Fiscalize\"."
msgstr "Збережений запит порожній; скористайтесь «Фіскалізувати»."

msgid "Unexpected response from AlliancePay."
msgstr "Неочікувана відповідь від AlliancePay."

msgid "AlliancePay fiscalization error: %s"
msgstr "Помилка фіскалізації AlliancePay: %s"

msgid "Required field is missing: %s"
msgstr "Відсутнє обов'язкове поле: %s"

msgid "Invalid field format: %s"
msgstr "Невірний формат поля: %s"

msgid "Payment operation not found in AlliancePay."
msgstr "Платіжну операцію не знайдено в AlliancePay."

msgid "Original receipt not found: fiscalize the purchase first, then the refund."
msgstr "Оригінальний чек не знайдено: спочатку фіскалізуйте покупку, потім повернення."

msgid "AlliancePay returned HTTP %s. Try again later."
msgstr "AlliancePay повернув HTTP %s. Спробуйте пізніше."

msgid "Receipt fiscalized, fiscal number: %s"
msgstr "Чек фіскалізовано, ФН: %s"

msgid "Fiscalization error: %1$s, %2$s"
msgstr "Помилка фіскалізації: %1$s, %2$s"

msgid "Fiscalization request accepted, awaiting result from Alliance Kasa."
msgstr "Запит на фіскалізацію прийнято, очікується результат від Alliance Kasa."

msgid "Fiscalization is currently supported only for orders in UAH."
msgstr "Наразі фіскалізація підтримується лише для замовлень у гривні."

msgid "Fiscalization notification URL must be absolute."
msgstr "URL сповіщень фіскалізації має бути абсолютним."

msgid "Successful purchase operation not found for this order."
msgstr "Успішну операцію покупки для цього замовлення не знайдено."

msgid "Refund operation not found for this order."
msgstr "Операцію повернення для цього замовлення не знайдено."

msgid "The refund operation is not successful yet."
msgstr "Операція повернення ще не успішна."

msgid "Unsupported operation type for fiscalization."
msgstr "Непідтримуваний тип операції для фіскалізації."

msgid "Operation amount is unknown."
msgstr "Сума операції невідома."

msgid "The order has no items to fiscalize."
msgstr "У замовленні немає позицій для фіскалізації."

msgid "Items total (%1$d) does not match the operation amount (%2$d)."
msgstr "Сума позицій (%1$d) не збігається із сумою операції (%2$d)."

msgid "Fiscalization"
msgstr "Фіскалізація"

msgid "Fiscalization of successful payments and refunds via Alliance Kasa. Default values below are used when a product has no own value."
msgstr "Фіскалізація успішних платежів і повернень через Alliance Kasa. Дефолтні значення нижче використовуються, якщо у товару немає власного значення."

msgid "Enable fiscalization"
msgstr "Увімкнути фіскалізацію"

msgid "Automatic fiscalization"
msgstr "Автоматична фіскалізація"

msgid "Tax group code (default)"
msgstr "Код податкової групи (дефолт)"

msgid "UKTZED code (default)"
msgstr "УКТЗЕД (дефолт)"

msgid "Excise stamps (default)"
msgstr "Акцизні марки (дефолт)"

msgid "Unit of measure code (default) *"
msgstr "Код одиниці виміру (дефолт) *"

msgid "Send fiscalization requests and show the fiscalization block in orders"
msgstr "Надсилати запити фіскалізації та показувати блок «Фіскалізація» в замовленнях"

msgid "Fiscalize automatically after a successful payment or refund"
msgstr "Фіскалізувати автоматично після успішного платежу чи повернення"

msgid "If disabled, neither payments nor refunds are fiscalized automatically; use the \"Fiscalize\" button in the order."
msgstr "Якщо вимкнено, ні платежі, ні повернення не фіскалізуються автоматично; використовуйте кнопку «Фіскалізувати» в замовленні."

msgid "Comma-separated or one per line. Used only for tax codes 2, 7, 8 for excise goods."
msgstr "Через кому або по одній в рядку. Використовується лише для кодів податку 2, 7, 8 для підакцизних товарів."

msgid "Integer, optional. Leave empty if the default tax group is not needed."
msgstr "Ціле число, необов'язково. Залиште порожнім, якщо дефолтна податкова група не потрібна."

msgid "Digits only (usually 10). Required if the default tax code is 2, 7 or 8."
msgstr "Лише цифри (зазвичай 10). Обов'язково, якщо дефолтний код податку 2, 7 або 8."

msgid "Required. Default \"0001\" (piece)."
msgstr "Обов'язково. За замовчуванням \"0001\" (штука)."

msgid "Unit of measure code is required."
msgstr "Код одиниці виміру обов'язковий."

msgid "EC P-256 private key in PEM format (PKCS#8) for signing JWS tokens (ES256). Keep this secret — never share it."
msgstr "Приватний ключ EC P-256 у форматі PEM (PKCS#8) для підпису JWS-токенів (ES256). Зберігайте в таємниці — нікому його не передавайте."

#. translators: %s: curve name
msgid "JWS Private Key must use the P-256 curve, got %s."
msgstr "Приватний ключ JWS має використовувати криву P-256, отримано %s."

msgid "Unsupported JWS Private Key type: EC P-256 key is required."
msgstr "Непідтримуваний тип приватного ключа JWS: потрібен ключ EC P-256."
